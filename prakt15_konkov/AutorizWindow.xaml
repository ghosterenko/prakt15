<Window x:Class="prakt15_konkov.AutorizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prakt15_konkov"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="Авторизация" Height="450" Width="800"
        Background="{StaticResource MainBg}">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход в систему"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource SecondaryColor}"
                       Margin="0,0,0,20"/>

            <TextBlock Text="ПИН-код менеджера:" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox Name="PinBox" Padding="6" FontSize="14"
                         Margin="0,0,0,15" Background="White"/>

            <Button Content="Войти как менеджер" Click="LoginManager_Click"
                    Height="40" FontSize="14"/>

            <Button Content="Войти как посетитель" Click="LoginVisitor_Click" Background="{StaticResource SecondaryColor}"
                    Height="40" FontSize="14" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
