<Application x:Class="prakt15_konkov.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:prakt15_konkov"
             StartupUri="AutorizWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="MainBg" Color="#dfeaeb"/>
            <SolidColorBrush x:Key="PrimaryColor" Color="#006c4b"/>
            <SolidColorBrush x:Key="SecondaryColor" Color="#00b4c4"/>
            <SolidColorBrush x:Key="LowStockColor" Color="#ffd129"/>

            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#006c4b"/>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground" Color="#ffffff"/>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary" Color="#00b4c4"/>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Foreground" Color="#ffffff"/>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="#dfeaeb"/>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground" Color="#222222"/>

            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="AutomationProperties.Name" Value=""/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
            </Style>

            <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignPasswordBox}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="AutomationProperties.Name" Value=""/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="BorderBrush" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>