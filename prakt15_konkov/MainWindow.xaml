<Window x:Class="prakt15_konkov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prakt15_konkov"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="Главная" Height="450" Width="800"
        Background="{StaticResource MainBg}">
    <Window.Resources>
        <local:BordConvertor x:Key="BordConvertor"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Фильтрация" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SecondaryColor}" Margin="0,0,0,15"/>

                <TextBlock Text="Поиск по названию:" FontWeight="SemiBold"/>
                <TextBox Name="SearchBox" TextChanged="FilterChanged"/>

                <TextBlock Text="Сортировка:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <ComboBox Name="SortBox" SelectionChanged="SortChanged">
                    <ComboBoxItem Tag="Name" Content="по наименованию"/>
                    <ComboBoxItem Tag="PriceAsc" Content="по цене (возрастание)"/>
                    <ComboBoxItem Tag="PriceDesc" Content="по цене (убывание)"/>
                    <ComboBoxItem Tag="StockAsc" Content="по остатку (возрастание)"/>
                    <ComboBoxItem Tag="StockDesc" Content="по остатку (убывание)"/>
                </ComboBox>

                <TextBlock Text="Цена (от и до):" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="PriceFrom" Grid.Column="0" TextChanged="FilterChanged"/>
                    <TextBlock Text="—" Grid.Column="1" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Name="PriceTo" Grid.Column="2" TextChanged="FilterChanged"/>
                </Grid>

                <Button Content="Сбросить фильтры" Click="Reset_Click" Background="{StaticResource SecondaryColor}" Margin="0,10,0,0"/>

                <StackPanel Name="ManagerPanel" Visibility="Collapsed" Margin="0,20,0,0">
                    <Separator Margin="0,0,0,15"/>
                    <TextBlock Text="Менеджер" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,10"/>
                    <Button Content="Добавить товар" Click="Add_Click" Background="{StaticResource SecondaryColor}"/>
                    <Button Content="Редактировать товар" Click="Edit_Click" Background="{StaticResource SecondaryColor}"/>
                    <Button Content="Удалить выбранный товар" Click="Delete_Click" Background="{StaticResource SecondaryColor}"/>
                    <Button Content="Управление" Click="References_Click" Background="{StaticResource SecondaryColor}" Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <ListView Name="ProductsList" Grid.Row="0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Name="CardBorder" BorderBrush="Transparent" BorderThickness="3" CornerRadius="6" Margin="0,4,0,6" Padding="12" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2} руб.'}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryColor}"/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Category.Name, StringFormat='Категория: {0}'}" Foreground="Gray"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,15,0" Foreground="#444444"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Stock, StringFormat='Остаток: {0} шт.'}" VerticalAlignment="Bottom" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Stock, Converter={StaticResource BordConvertor}}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource LowStockColor}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="10,0" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="TotalCountText" Margin="0,0,25,0" FontWeight="SemiBold"/>
                    <TextBlock Name="FilteredCountText" FontWeight="SemiBold" Foreground="{StaticResource SecondaryColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
